{"nodes": [{"id": "docs_backend_ref_design_examhallsignage", "label": "Exam-Hall Signage Design System (B\u1ea3ng hi\u1ec7u ph\u00f2ng thi)", "file_type": "rationale", "rationale": "Refuses pale-blue SaaS card grids with soft shadows; uses flat painted fields, 2px Ink keylines, 1px soft interior rules, zero border radius, zero elevation/shadow, and solid Ink inversion.", "source_file": "docs/backend-ref/DESIGN.md", "source_location": "L215-L237", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_ref_design_signagepalette", "label": "Four-Field Signage Color Palette", "file_type": "concept", "source_file": "docs/backend-ref/DESIGN.md", "source_location": "L238-L272", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_ref_design_ibmplextypography", "label": "IBM Plex Superfamily Typography (Sans, Sans Condensed, Mono)", "file_type": "rationale", "rationale": "Self-hosted Latin and Vietnamese subsets split functionally: Sans for reading, Condensed uppercase for signage chrome, and Mono tabular numerals for figures that must not jitter.", "source_file": "docs/backend-ref/DESIGN.md", "source_location": "L281-L307", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_ref_design_oneflatfieldrule", "label": "The One Flat Field & Keyline-Not-Blur Rules", "file_type": "rationale", "rationale": "No gradient, shadow, or blur; depth is carried by 2px ink outer frames and 1px soft interior dividers.", "source_file": "docs/backend-ref/DESIGN.md", "source_location": "L275-L276,L324-L333", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_ref_design_inversionrule", "label": "The Inversion Rule", "file_type": "rationale", "rationale": "Active or selected state inverts to a solid ink block (#14181d) with white lettering rather than tinting.", "source_file": "docs/backend-ref/DESIGN.md", "sou